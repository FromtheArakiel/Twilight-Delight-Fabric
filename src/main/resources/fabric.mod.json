{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/twilightdelight/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.arakiel.twilightdelight.TwilightDelightFabric"
    ],
    "client": [
      "dev.arakiel.twilightdelight.client.TwilightDelightFabricClient"
    ],
    "gemini:components": [
      "dev.arakiel.twilightdelight.component.TDComponents"
    ],
    "jei_mod_plugin": [
      "dev.arakiel.twilightdelight.compat.jei.TwilightJeiPlugin"
    ],
    "jade": [
      "dev.arakiel.twilightdelight.compat.jade.TwilightJadePlugin"
    ]
  },
  "accessWidener": "twilightdelight.accesswidener",
  "mixins": [
    "twilightdelight.mixins.json",
    {
      "config": "twilightdelight.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "gemini": ">=1.0.3",
    "farmersdelight": ">=1.21.1-3.3.6",
    "twilightforest": ">=4.8.754"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "patchouli": "*"
  },
  "custom": {
    "gemini:components": [
      "twilightdelight:sips",
      "twilightdelight:uses"
    ]
  }
}
